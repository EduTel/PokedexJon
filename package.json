{
  "name": "PokedexJon",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "WITH_ROZENITE=true react-native run-android",
    "ios": "WITH_ROZENITE=true react-native run-ios",
    "lint": "eslint .",
    "start": "WITH_ROZENITE=true react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "maestro test maestro/pokedex_flow.yaml",
    "security:trivy": "trivy fs --severity HIGH,CRITICAL --skip-dirs node_modules,android/app/build,android/.gradle,ios/build,ios/Pods .",
    "dependency-cruiser": "npx depcruise --no-config --ts-config ./tsconfig.json --max-depth 8 --exclude 'node_modules|react-native' --output-type dot App.tsx | dot -T svg > dependency-graph.svg",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@legendapp/list": "^3.3.11",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-error-boundary": "^3.1.0",
    "react-native-exception-handler": "^2.10.10",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@rozenite/metro": "^2.4.0",
    "@rozenite/network-activity-plugin": "^2.4.0",
    "@rozenite/react-navigation-plugin": "^2.4.0",
    "@rozenite/storage-plugin": "^2.4.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
